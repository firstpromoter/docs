{
  "openapi": "3.0.1",
  "info": {
    "title": "FirstPromoter API",
    "version": "1.0",
    "description": "API documentation for FirstPromoter affiliate referral links management"
  },
  "servers": [
    {
      "url": "https://api.firstpromoter.com/api/v2/affiliate"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/referral_links": {
      "get": {
        "summary": "Get current promoter referral links",
        "operationId": "getReferralLinks",
        "parameters": [
          {
            "$ref": "#/components/parameters/AccountId"
          },
          {
            "name": "promoter_campaign_id",
            "in": "query",
            "description": "If provided, it returns only the links related to the given campaign",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of referral links",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ReferralLink"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized \u2014 the API key is missing, wrong, regenerated or disabled (no JSON response body is returned), or the `Account-ID` header is missing.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {}
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Creates a referral link",
        "operationId": "createReferralLink",
        "parameters": [
          {
            "$ref": "#/components/parameters/AccountId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "promoter_campaign_id": {
                    "type": "integer",
                    "description": "ID of one of the promoter's promoter campaigns"
                  },
                  "name": {
                    "type": "string",
                    "maxLength": 80,
                    "pattern": "^[a-zA-Z0-9_ -]+$",
                    "description": "Name of the link: letters, numbers, spaces, `_` and `-`, up to 80 characters"
                  },
                  "url": {
                    "type": "string",
                    "description": "Destination URL of the link. Must be a valid URL on a registrable domain (for example `https://example.com/pricing`)."
                  },
                  "sub_id": {
                    "type": "string",
                    "maxLength": 16,
                    "pattern": "^[a-zA-Z0-9_]+$",
                    "description": "Sub id that identifies this link in reports: letters, numbers and `_`, up to 16 characters, saved in lowercase. Must be unique among the promoter's links in the campaign."
                  }
                },
                "required": [
                  "promoter_campaign_id",
                  "name",
                  "url"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created referral link",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReferralLink"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized \u2014 the API key is missing, wrong, regenerated or disabled (no JSON response body is returned), or the `Account-ID` header is missing.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {}
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed, for example an invalid URL or name",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                },
                "example": {
                  "message": "Validation failed: Url must be a valid URL, Url Invalid domain",
                  "errors": {
                    "url": [
                      "must be a valid URL",
                      "Invalid domain"
                    ]
                  },
                  "code": "invalid_record"
                }
              }
            }
          },
          "404": {
            "description": "Promoter campaign not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "message": "Record not found",
                  "code": "not_found"
                }
              }
            }
          },
          "422": {
            "description": "`promoter_campaign_id` is missing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "message": "param is missing or the value is empty or invalid: promoter_campaign_id",
                  "code": "invalid_params"
                }
              }
            }
          }
        },
        "x-mint": {
          "metadata": {
            "noindex": true
          }
        }
      }
    },
    "/referral_links/{id}": {
      "put": {
        "summary": "Updates a referral link",
        "operationId": "updateReferralLink",
        "parameters": [
          {
            "$ref": "#/components/parameters/AccountId"
          },
          {
            "name": "id",
            "in": "path",
            "description": "ID of the referral link to update",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 80,
                    "pattern": "^[a-zA-Z0-9_ -]+$",
                    "description": "Name of the link: letters, numbers, spaces, `_` and `-`, up to 80 characters"
                  },
                  "url": {
                    "type": "string",
                    "description": "Destination URL of the link. Must be a valid URL on a registrable domain (for example `https://example.com/pricing`)."
                  },
                  "sub_id": {
                    "type": "string",
                    "maxLength": 16,
                    "pattern": "^[a-zA-Z0-9_]+$",
                    "description": "Sub id that identifies this link in reports: letters, numbers and `_`, up to 16 characters, saved in lowercase. Must be unique among the promoter's links in the campaign."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated referral link",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReferralLink"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed, for example an invalid URL or name. Nothing is saved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                },
                "example": {
                  "message": "Validation failed: Name is invalid",
                  "errors": {
                    "name": [
                      "is invalid"
                    ]
                  },
                  "code": "invalid_record"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized \u2014 the API key is missing, wrong, regenerated or disabled (no JSON response body is returned), or the `Account-ID` header is missing.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {}
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Referral link not found. Only links the promoter created can be changed or deleted; the campaign's links return 404.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "message": "Record not found",
                  "code": "not_found"
                }
              }
            }
          }
        },
        "x-mint": {
          "metadata": {
            "noindex": true
          }
        }
      },
      "delete": {
        "summary": "Destroys a referral link",
        "operationId": "deleteReferralLink",
        "parameters": [
          {
            "$ref": "#/components/parameters/AccountId"
          },
          {
            "name": "id",
            "in": "path",
            "description": "The id of the referral_link to be destroyed",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Referral link deleted successfully"
          },
          "401": {
            "description": "Unauthorized \u2014 the API key is missing, wrong, regenerated or disabled (no JSON response body is returned), or the `Account-ID` header is missing.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {}
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Referral link not found. Only links the promoter created can be changed or deleted; the campaign's links return 404.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "message": "Record not found",
                  "code": "not_found"
                }
              }
            }
          }
        },
        "x-mint": {
          "metadata": {
            "noindex": true
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "AccountId": {
        "name": "Account-ID",
        "in": "header",
        "required": true,
        "description": "Account ID of the affiliate program, shown next to your API key under Profile → API & AI tools",
        "schema": {
          "type": "string",
          "example": "acc_123456"
        }
      }
    },
    "schemas": {
      "ReferralLink": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "nullable": true,
            "description": "ID of the link. `null` for the campaign's default link."
          },
          "name": {
            "type": "string",
            "description": "Name of the link. `Default` for the campaign's default link."
          },
          "url": {
            "type": "string",
            "description": "In the list response, the promoter's shareable tracking link for this destination. In the create and update responses, the destination page without tracking parameters; call the list endpoint for the tracking link."
          },
          "destination_url": {
            "type": "string",
            "description": "The page the link sends visitors to, without tracking parameters."
          },
          "is_default": {
            "type": "boolean",
            "nullable": true,
            "description": "`true` for the campaign's default link, `null` otherwise."
          },
          "source": {
            "type": "string",
            "enum": [
              "campaign",
              "promoter"
            ],
            "description": "`campaign` for links the campaign provides, `promoter` for links the promoter created."
          },
          "sub_id": {
            "type": "string",
            "nullable": true
          },
          "campaign": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              },
              "name": {
                "type": "string"
              },
              "color": {
                "type": "string",
                "nullable": true
              },
              "language": {
                "type": "string",
                "nullable": true
              }
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        },
        "required": [
          "message",
          "code"
        ]
      },
      "ValidationError": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "errors": {
            "type": "object",
            "description": "Validation errors by field",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "code": {
            "type": "string",
            "example": "invalid_record"
          }
        },
        "required": [
          "message",
          "code"
        ]
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Your affiliate API key (Profile → API & AI tools in the affiliate dashboard), sent as `Authorization: Bearer {api_key}`"
      }
    }
  }
}
